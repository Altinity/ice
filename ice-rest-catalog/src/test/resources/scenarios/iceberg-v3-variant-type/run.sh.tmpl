#!/bin/bash
set -e

echo "Running Iceberg v3 variant-type (--schema) test..."

# Create namespace
{{ICE_CLI}} --config {{CLI_CONFIG}} create-namespace ${NAMESPACE_NAME}
echo "OK Created namespace: ${NAMESPACE_NAME}"

# Create a v3 table with an explicit schema containing v3-only variant columns,
# both top-level and nested inside a struct
{{ICE_CLI}} --config {{CLI_CONFIG}} create-table ${TABLE_NAME} --format-version=3 \
  --schema '[{"name":"id","type":"long","required":true},{"name":"payload","type":"variant"},{"name":"s","type":"struct<a:string,b:variant>"}]'
echo "OK Created table ${TABLE_NAME} via --schema (variant columns)"

# Verify schema output shows the variant columns
{{ICE_CLI}} --config {{CLI_CONFIG}} describe -s ${TABLE_NAME} > /tmp/v3_variant_schema.txt
if ! grep -q "payload: optional variant" /tmp/v3_variant_schema.txt; then
  echo "FAIL describe -s output missing 'payload: optional variant'"
  cat /tmp/v3_variant_schema.txt
  exit 1
fi
echo "OK describe -s shows payload: optional variant"
if ! grep -q "b: optional variant" /tmp/v3_variant_schema.txt; then
  echo "FAIL describe -s output missing nested 'b: optional variant'"
  cat /tmp/v3_variant_schema.txt
  exit 1
fi
echo "OK describe -s shows nested b: optional variant"

# Verify describe output shows formatVersion 3 (Iceberg strips format-version from properties)
{{ICE_CLI}} --config {{CLI_CONFIG}} describe ${TABLE_NAME} > /tmp/v3_variant_describe.txt
if ! grep -q "formatVersion: 3" /tmp/v3_variant_describe.txt; then
  echo "FAIL describe output missing 'formatVersion: 3'"
  cat /tmp/v3_variant_describe.txt
  exit 1
fi
echo "OK describe shows formatVersion: 3"

# Negative: variant type must be rejected without --format-version=3 (default is v2)
if {{ICE_CLI}} --config {{CLI_CONFIG}} create-table ${NAMESPACE_NAME}.t2 \
    --schema '[{"name":"payload","type":"variant"}]' > /tmp/v3_variant_v2.out 2>&1; then
  echo "FAIL create-table with variant type on v2 succeeded unexpectedly"
  exit 1
fi
if ! grep -q "not supported until v3" /tmp/v3_variant_v2.out; then
  echo "FAIL v2 rejection missing 'not supported until v3'"
  cat /tmp/v3_variant_v2.out
  exit 1
fi
echo "OK v2 table with variant type rejected"

# Cleanup
{{ICE_CLI}} --config {{CLI_CONFIG}} delete-table ${TABLE_NAME}
echo "OK Deleted table: ${TABLE_NAME}"

{{ICE_CLI}} --config {{CLI_CONFIG}} delete-namespace ${NAMESPACE_NAME}
echo "OK Deleted namespace: ${NAMESPACE_NAME}"

echo "Iceberg v3 variant-type test completed successfully"
